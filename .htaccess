# ============================================================
# Apache sozlamalari (ahost / cPanel va boshqa Apache hostinglar uchun)
# Statik sayt: HTML + CSS + JS + PDF
#
# Faqat eng keng ruxsat etilgan direktivalar ishlatilgan (AllowOverride FileInfo).
# DirectoryIndex, Expires va Options ataylab qo'yilmagan: ular ko'p shared
# hostinglarda ruxsat etilmaydi va butun saytga 500 xato beradi.
# index.html Apache'da standart bosh sahifa bo'lgani uchun DirectoryIndex shart emas.
# ============================================================

# ---------- MIME turlari ----------
# Ba'zi hostinglar CSS/JS ni noto'g'ri turda beradi — brauzer ularni rad etadi
<IfModule mod_mime.c>
    AddType text/css                      .css
    AddType application/javascript        .js
    AddType image/svg+xml                 .svg
    AddType application/pdf               .pdf
    AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
    AddType text/html                     .html .htm
    # O'zbek matni to'g'ri ko'rinishi uchun
    AddCharset UTF-8 .html .css .js .md
</IfModule>

# ---------- Siqish (tezroq yuklanish) ----------
# AddOutputFilterByType mod_filter'ni talab qiladi — u yo'q bo'lsa 500 bermasligi uchun
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css text/plain
        AddOutputFilterByType DEFLATE application/javascript application/json
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
</IfModule>

# ---------- Kesh va xavfsizlik ----------
<IfModule mod_headers.c>
    # HTML har safar yangidan tekshiriladi — yangi versiya darhol ko'rinadi
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # CSS/JS havolalarida ?v=... versiya bor, shuning uchun keshlash xavfsiz
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(pdf|docx|svg)$">
        Header set Cache-Control "max-age=604800"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
