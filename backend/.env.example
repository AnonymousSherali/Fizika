# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring. .env repozitoriyga yozilmaydi!
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=site.uz,www.site.uz,localhost
CSRF_TRUSTED_ORIGINS=https://site.uz
CORS_ALLOWED_ORIGINS=         # sayt va API bir domenda bo'lsa bo'sh qoldiring

DATABASE_URL=postgres://fizika:fizika@db:5432/fizika
POSTGRES_DB=fizika
POSTGRES_USER=fizika
POSTGRES_PASSWORD=fizika

REDIS_URL=redis://redis:6379/0

# Sayt manzili: emaildagi havolalar va dars ishlanmalarni yuklab olish uchun
SITE_URL=https://site.uz/

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# SMS: console (kod logga yoziladi) yoki eskiz (Eskiz.uz)
SMS_PROVIDER=console
SMS_API_TOKEN=

# Email (o'qituvchilarga kod va bildirishnomalar)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fizika 10–11 <noreply@site.uz>

# HTTPS (deploy/nginx-ssl.conf) ishlaguncha false; keyin true
SECURE_SSL_REDIRECT=true

# Admin panelga kirishda 2FA (TOTP). Yoqilgach: python manage.py admin_2fa_setup <login>
ADMIN_2FA=true
# Xatolar monitoringi (ixtiyoriy)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Baza ulanishini qayta ishlatish (soniya)
DB_CONN_MAX_AGE=60
# nginx ortida: mijoz IP si X-Forwarded-For ning oxirgi qiymatidan (soxtalashtirilmaydi)
NUM_PROXIES=1
# Maxfiy fayllarni nginx beradi (X-Accel-Redirect)
MEDIA_X_ACCEL=true
